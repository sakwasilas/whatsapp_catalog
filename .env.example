# Copy these into your host's environment settings (never commit real values).
APP_ENV=production
SECRET_KEY=generate-with-python-c-"import secrets;print(secrets.token_hex(32))"
DATABASE_URL=mysql+pymysql://catalog_user:STRONG_PASSWORD@localhost/business_db
TRUST_PROXY=1                    # set when behind nginx / a PaaS router

PLATFORM_NAME=Duka yangu
SUPPORT_WHATSAPP=254712345678    # shown on the forgot-password page and footer
MPESA_PAYBILL=123456
MPESA_ACCOUNT_NAME=Your Business Name
PREMIUM_PRICE=100

# Email (needed for password reset + email confirmation). Leave MAIL_HOST empty in development:
# emails are then printed to the server log instead of sent.
# Gmail SMTP (use a Google App Password, never your normal Gmail password)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=youraddress@gmail.com
MAIL_PASSWORD=your-16-character-google-app-password
MAIL_USE_SSL=0
MAIL_FROM=Duka Yangu <youraddress@gmail.com>
